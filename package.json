{
  "name": "terroir-case-study",
  "private": true,
  "description": "Automated checks for the Terroir case study (static HTML, no build step).",
  "scripts": {
    "check:html": "html-validate index.html 404.html",
    "check:links": "linkinator index.html 404.html --recurse --skip \"linkedin\\.com|terroir\\.streamlit\\.app|gabrielaolivera\\.nz/terroir-case-study|terroir-case-study/\"",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "check:canonical": "node scripts/check-canonical-urls.mjs",
    "serve": "http-server . -p 8080 -s",
    "check": "npm run check:html && npm run check:links && npm run check:a11y && npm run check:overflow && npm run check:canonical"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.10.2",
    "axe-core": "^4.12.1",
    "browser-driver-manager": "^2.0.1",
    "html-validate": "^9.7.1",
    "http-server": "^14.1.1",
    "linkinator": "^6.1.2",
    "selenium-webdriver": "^4.44.0"
  }
}
